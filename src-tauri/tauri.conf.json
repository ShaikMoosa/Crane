{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crane",
  "version": "0.1.0",
  "identifier": "app.crane.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Crane",
        "width": 1240,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calm, private Markdown notebook",
    "longDescription": "Crane is a local-first desktop notebook for Markdown writing, inline tags, and focused organization.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}

